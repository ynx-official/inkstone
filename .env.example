# Copy to .env.production.local to override production without changing defaults.
# VITE_* values are public. Never add database, S3 or session credentials here.
VITE_API_BASE_URL=https://api.example.com/prod-api/

# For local development, put this in .env.development.local instead:
# INKSTONE_API_TARGET=http://127.0.0.1:8081
